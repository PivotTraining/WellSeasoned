{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/f/:id", "destination": "/api/f?id=:id" },
    { "source": "/apply/:role", "destination": "/api/apply?role=:role" },
    { "source": "/apply", "destination": "/api/apply?role=critic" },
    { "source": "/read/:slug", "destination": "/api/read?slug=:slug" },
    { "source": "/advertise", "destination": "/api/advertise" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" }
  ]
}

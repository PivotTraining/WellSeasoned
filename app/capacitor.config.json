{
  "appId": "com.wellseasoned.app",
  "appName": "Well Seasoned",
  "webDir": "www",
  "bundledWebRuntime": false,
  "server": {
    "url": "https://itswellseasoned.com",
    "cleartext": false
  },
  "ios": {
    "contentInset": "automatic",
    "backgroundColor": "#EFE2C6"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 400,
      "backgroundColor": "#EFE2C6",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#EFE2C6"
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    }
  }
}
